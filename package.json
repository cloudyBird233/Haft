{
  "name": "raft-lite",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "predev": "pnpm --filter @raft-lite/contracts build",
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @raft-lite/api dev\" \"pnpm --filter @raft-lite/web dev\"",
    "prebuild": "pnpm --filter @raft-lite/contracts build",
    "build": "pnpm --filter @raft-lite/api build && pnpm --filter @raft-lite/web build && pnpm --filter @raft-lite/runner build",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "pnpm --filter @raft-lite/contracts build",
    "typecheck": "pnpm -r --if-present typecheck",
    "pretest": "pnpm --filter @raft-lite/contracts build",
    "test": "pnpm --filter @raft-lite/contracts test && pnpm --filter @raft-lite/api test && pnpm --filter @raft-lite/runner test && pnpm --filter @raft-lite/web test",
    "pretest:e2e": "pnpm --filter @raft-lite/contracts build && pnpm --filter @raft-lite/api db:prepare:e2e",
    "test:e2e": "playwright test",
    "pretest:e2e:real": "pnpm --filter @raft-lite/contracts build && pnpm --filter @raft-lite/api db:prepare:real-e2e",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "runner:dev": "pnpm --filter @raft-lite/contracts build && pnpm --filter @raft-lite/runner dev",
    "runner:start": "pnpm --filter @raft-lite/contracts build && pnpm --filter @raft-lite/runner start",
    "show-report": "playwright show-report",
    "db:migrate": "pnpm --filter @raft-lite/api db:migrate",
    "db:seed": "pnpm --filter @raft-lite/api db:seed",
    "db:studio": "pnpm --filter @raft-lite/api db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@raft-lite/contracts": "workspace:*",
    "concurrently": "^9.2.1",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.40.0"
  }
}
