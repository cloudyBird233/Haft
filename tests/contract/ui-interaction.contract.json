{
  "version": "1.0.0",
  "name": "Raft Lite UI interaction contract",
  "description": "Single machine-readable description of the user-visible routes, controls, states and signals exercised by the functional, business-loop and visual E2E suites.",
  "testIdAttribute": "data-testid",
  "baseUrl": {
    "env": "E2E_BASE_URL",
    "default": "http://127.0.0.1:5174"
  },
  "routes": {
    "dashboard": "/",
    "agents": "/agents",
    "projects": "/projects",
    "projectDetail": "/projects?project={projectId}",
    "tasks": "/tasks",
    "taskDetail": "/tasks?task={taskId}",
    "execution": "/executions/{executionId}"
  },
