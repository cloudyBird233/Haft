  "taskLanes": {
    "todo": ["todo"],
    "active": ["claimed", "in_progress"],
    "review": ["in_review"],
    "done": ["done"],
    "stopped": ["failed", "cancelled"]
  },
  "uiStates": {
    "form": ["idle", "submitting", "error"],
    "execution": ["running", "completed", "failed", "cancelled"],
    "agent": ["idle", "busy", "offline", "error"],
    "task": ["todo", "claimed", "in_progress", "in_review", "done", "failed", "cancelled"]
  },
  "flows": {
    "createProject": [
      "navigate.projects",
      "click.projects.create",
      "fill.projectForm.key",
      "fill.projectForm.name",
      "fill.projectForm.defaultBranch",
      "click.projectForm.submit",
      "expect.toast",
      "expect.projects.card"
    ],
    "bindRepository": [
      "expect.projectDetail.panel",
      "click.projectBindings.create",
      "select.bindingForm.computer",
      "fill.bindingForm.path",
      "click.bindingForm.submit",
      "expect.projectBindings.row"
    ],
    "createAgent": [
      "navigate.agents",
      "click.agents.create",
      "fill.agentForm.name",
      "fill.agentForm.role",
      "fill.agentForm.description",
      "select.agentForm.runtime",
      "click.agentForm.submit",
      "expect.toast",
      "expect.agents.card"
    ],
    "createTask": [
      "navigate.tasks",
      "click.tasks.create",
      "fill.taskForm.title",
      "fill.taskForm.description",
      "select.taskForm.assignee",
      "select.taskForm.priority",
      "click.taskForm.submit",
      "expect.toast",
      "expect.taskBoard.card"
    ],
    "startExecution": [
      "navigate.taskDetail",
      "expect.taskDetail.panel",
      "click.taskDetail.start",
      "expect.url.execution",
      "expect.execution.statusBanner.running",
      "expect.execution.log"
    ],
    "stopExecution": [
      "click.execution.stop",
      "expect.execution.stopDialog",
      "click.execution.stopConfirm",
      "expect.execution.statusBanner.cancelled",
      "expect.execution.cancelReason"
    ],
    "inspectExecutionChanges": [
      "navigate.execution",
      "expect.execution.page",
      "click.execution.changesTab",
      "expect.execution.diffPanel",
      "expect.execution.changedFiles",
      "expect.execution.diffFile",
      "expect.execution.diffContent",
      "expect.execution.diffTruncated"
    ]
  },
  "testApi": {
    "baseUrl": {
      "env": "E2E_API_URL",
      "default": "http://127.0.0.1:3101"
    },
    "enabledWhen": "E2E_TEST_MODE=true and NODE_ENV!=production",
    "endpoints": {
      "reset": {
        "method": "POST",
        "path": "/__test__/reset",
        "body": { "preset": "default|empty" }
      },
      "seed": { "method": "POST", "path": "/__test__/seed", "body": { "preset": "default|empty" } },
      "runtimeMode": {
        "method": "POST",
        "path": "/__test__/runtime/mode",
        "body": { "mode": "auto|manual" }
      },
      "advanceExecution": {
        "method": "POST",
        "path": "/__test__/executions/{executionId}/advance",
        "body": { "steps": "1..20" }
      },
      "finishExecution": {
        "method": "POST",
        "path": "/__test__/executions/{executionId}/finish",
        "body": { "outcome": "success|failure", "reason": "optional" }
      }
    }
  },
  "deterministicSeed": {
    "workspaceId": "ws_demo",
    "projectId": "project_demo",
    "agents": ["agent_architect", "agent_developer", "agent_qa"],
    "tasks": [
      "task_workspace_shell",
      "task_arch_review",
      "task_log_viewer",
      "task_activity_contract"
    ],
    "completedExecutionId": "execution_seed_completed"
  }
}
