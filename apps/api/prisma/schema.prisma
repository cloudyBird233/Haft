generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  projects   Project[]
  agents     Agent[]
  tasks      Task[]
  activities Activity[]
}

model Project {
  id                 String                     @id @default(cuid())
  workspaceId        String
  key                String
  name               String
  description        String                     @default("")
  color              String                     @default("#6b7280")
  defaultBranch      String                     @default("main")
  archivedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks              Task[]
  repositoryBindings ProjectRepositoryBinding[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
}

/// A Project's repository path on one Computer. The path is opaque user input;
/// only a runner response may move the binding out of `unverified`.
model ProjectRepositoryBinding {
  id                      String      @id @default(cuid())
  projectId               String
  computerId              String
  path                    String
  pathHash                String
  bindingVersion          Int         @default(1)
  platform                String?
  status                  String      @default("unverified")
  validationRequestId     String?
  canonicalPath           String?
  validationErrorCode     String?
  validationError         String?
  lastValidatedAt         DateTime?
  validatedByRunnerId     String?
  validatedBindingVersion Int?
  policyVersion           String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  project                 Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  computer                Computer    @relation(fields: [computerId], references: [id], onDelete: Cascade)
  validatedByRunner       Runner?     @relation(fields: [validatedByRunnerId], references: [id], onDelete: SetNull)
  executions              Execution[]

  @@unique([projectId, computerId])
  @@index([projectId, status])
  @@index([computerId])
  @@index([validatedByRunnerId])
}

model Computer {
  id                 String                     @id @default(cuid())
  name               String
  hostname           String
  status             String                     @default("online")
  lastSeenAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  agents             Agent[]
  runner             Runner?
  repositoryBindings ProjectRepositoryBinding[]
}

/// A Haft Agent Runner process registered against one Computer.
/// Token material is stored as a one-way hash only.
model Runner {
  id                      String                     @id @default(cuid())
  computerId              String                     @unique
  tokenHash               String
  protocolVersion         Int                        @default(1)
  runnerVersion           String                     @default("")
  platform                String                     @default("")
  architecture            String                     @default("")
  status                  String                     @default("offline")
  capabilitiesJson        String                     @default("{}")
  maxConcurrentExecutions Int                        @default(1)
  lastHeartbeatAt         DateTime?
  connectedAt             DateTime?
  disconnectedAt          DateTime?
  /// Identity of the current registration epoch. Rotated on every accepted
  /// `runner.register`; `registrationEpoch` is monotonic and may only advance
  /// together with a new `registrationId` (enforced by
  /// `Runner_registration_guard`).
  registrationId          String?                    @unique
  registrationEpoch       Int                        @default(0)
  lastRegisteredAt        DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  computer                Computer                   @relation(fields: [computerId], references: [id], onDelete: Cascade)
  executions              Execution[]
  validatedBindings       ProjectRepositoryBinding[]

  @@index([status])
  @@index([lastHeartbeatAt])
  @@index([lastRegisteredAt])
}

model Agent {
  id           String      @id @default(cuid())
  workspaceId  String
  computerId   String?
  name         String
  role         String
  description  String      @default("")
  runtime      String      @default("mock")
  status       String      @default("idle")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lastActiveAt DateTime?
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  computer     Computer?   @relation(fields: [computerId], references: [id], onDelete: SetNull)
  tasks        Task[]      @relation("TaskAssignee")
  executions   Execution[]
  activities   Activity[]

  @@index([workspaceId])
  @@index([status])
}

model Task {
  id              String      @id @default(cuid())
  workspaceId     String
  projectId       String
  assigneeAgentId String?
  title           String
  description     String      @default("")
  priority        String      @default("medium")
  status          String      @default("todo")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee        Agent?      @relation("TaskAssignee", fields: [assigneeAgentId], references: [id], onDelete: SetNull)
  executions      Execution[]
  activities      Activity[]

  @@index([workspaceId])
  @@index([status])
  @@index([assigneeAgentId])
}

model Execution {
  id                        String                     @id @default(cuid())
  taskId                    String
  agentId                   String
  runnerId                  String?
  repositoryProjectId       String?
  repositoryBindingId       String?
  repositoryBindingVersion  Int?
  repositoryDefaultBranch   String?
  repositoryPath            String?
  repositoryPolicyVersion   String?
  repositoryContextId       String?
  repositoryBaseCommit      String?
  repositoryPreparedAt      DateTime?
  dispatchState             String                     @default("created")
  /// Registration the execution is bound to. Slice 1 only records the binding;
  /// takeover decisions are Slice 2.
  registrationId            String?
  registrationEpoch         Int                        @default(0)
  /// Start clock. `startSentAt` and `startAcceptDeadlineAt` are write-once
  /// (enforced by `Execution_start_clock_guard`); `recoveryDeadlineAt` may only
  /// move earlier.
  startSentAt               DateTime?
  startAcceptDeadlineAt     DateTime?
  recoveryDeadlineAt        DateTime?
  /// Terminal tuple. Written exactly once, by the API, on the transition out of
  /// `running`. `terminalDecision` is one of the 13 frozen values.
  terminalDecision          String?
  terminalDecidedAt         DateTime?
  terminalDecidedBy         String?
  /// Durable operator cancel intent. Set before any Runner cancel message is
  /// sent and checked by every pre-start handshake transition. It is an
  /// internal field, not a substitute dispatch state.
  cancelRequestedAt         DateTime?
  runtime                   String                     @default("mock")
  status                    String                     @default("running")
  phase                     String                     @default("running")
  progress                  Int                        @default(0)
  progressMode              String                     @default("determinate")
  exitCode                  Int?
  summary                   String?
  branchName                String?
  baseCommit                String?
  headCommit                String?
  changedFiles              Int                        @default(0)
  diffStat                  String                     @default("")
  gitStatus                 String                     @default("")
  diffTruncated             Boolean                    @default(false)
  lastRunnerSeq             Int                        @default(0)
  startedAt                 DateTime                   @default(now())
  endedAt                   DateTime?
  failureReason             String?
  cancelReason              String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  task                      Task                       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent                     Agent                      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runner                    Runner?                    @relation(fields: [runnerId], references: [id], onDelete: SetNull)
  repositoryBinding         ProjectRepositoryBinding?  @relation(fields: [repositoryBindingId], references: [id], onDelete: SetNull)
  logs                      ExecutionLog[]
  artifacts                 ExecutionArtifact[]
  activities                Activity[]
  repositoryHandshakeEvents RepositoryHandshakeEvent[]
  handshakeMessages         RepositoryHandshakeMessage[]
  registrationAudits        ExecutionRegistrationAudit[]

  @@index([taskId])
  @@index([agentId])
  @@index([runnerId])
  @@index([repositoryBindingId])
  @@index([status])
  @@index([phase])
  @@index([dispatchState])
  @@index([runnerId, dispatchState])
  @@index([status, dispatchState])
  @@index([runnerId, registrationEpoch])
  @@index([recoveryDeadlineAt])
  @@index([terminalDecision])
}

/// Durable audit trail for the execution repository handshake. It never stores
/// prompts, tokens, diffs or raw repository contents.
model RepositoryHandshakeEvent {
  id             String    @id @default(cuid())
  executionId    String
  state          String
  bindingVersion Int?
  policyVersion  String?
  code           String?
  message        String?
  createdAt      DateTime  @default(now())
  execution      Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}

/// Durable execution payload that is too large for the execution list DTO.
/// The unified diff lives here and is fetched through GET /api/executions/:id/diff.
model ExecutionArtifact {
  id          String    @id @default(cuid())
  executionId String
  kind        String    @default("git-diff")
  content     String
  byteSize    Int
  truncated   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, kind])
  @@index([executionId])
}

/// Durable evidence for an outbound execution handshake message.
///
/// The row is written *before* the message is handed to the transport, so
/// `status = created` is the durable proof that a message may have been built
/// but was not necessarily sent. `execution.start` is persisted at most once per
/// execution (partial unique index in migration
/// `20261116120000_p2_02_wpd_slice1_schema_migration`); the row is evidence,
/// never a replay source.
///
/// `envelopeJson` never contains the raw prompt or task description for
/// `execution.start`: sensitive fields are stored as content digests in the
/// envelope's `redacted` block. See the Slice 1 report for the open ratification
/// item.
model RepositoryHandshakeMessage {
  id                         String    @id @default(cuid())
  executionId                String
  /// Deliberately not a foreign key: message evidence must survive Runner
  /// deletion (an Execution keeps its history, the Runner row may be removed).
  runnerId                   String
  messageType                String
  messageId                  String    @unique
  protocolVersion            Int       @default(1)
  attempt                    Int       @default(1)
  envelopeJson               String
  payloadHash                String
  canonicalizationVersion    String    @default("haft-jcs-1")
  createdRegistrationId      String
  createdRegistrationEpoch   Int       @default(0)
  status                     String    @default("created")
  sentAt                     DateTime?
  ackedAt                    DateTime?
  lastReplayedAt             DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  execution                  Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, messageType, attempt])
  @@index([executionId, messageType, createdAt])
  @@index([status, createdAt])
  @@index([runnerId, status])
}

/// Append-only audit of registration takeovers.
///
/// Updates are rejected by `ExecutionRegistrationAudit_no_update`; rows are only
/// removed together with their Execution. `runnerId` is intentionally not a
/// foreign key so a deleted Runner cannot erase takeover history.
model ExecutionRegistrationAudit {
  id                        String    @id @default(cuid())
  executionId               String
  runnerId                  String
  previousRegistrationId    String?
  previousRegistrationEpoch Int?
  newRegistrationId         String
  newRegistrationEpoch      Int
  dispatchState             String
  decision                  String
  reasonCode                String?
  detail                    String?
  messageId                 String?
  createdAt                 DateTime  @default(now())
  execution                 Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@index([runnerId, createdAt])
}

model ExecutionLog {
  id          String    @id @default(cuid())
  executionId String
  seq         Int
  stream      String    @default("system")
  eventId     String?
  runnerSeq   Int?
  level       String    @default("info")
  message     String
  timestamp   DateTime  @default(now())
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, seq])
  @@unique([executionId, eventId])
  @@unique([executionId, runnerSeq])
  @@index([executionId, timestamp])
}

model Activity {
  id          String     @id @default(cuid())
  workspaceId String
  type        String
  summary     String
  taskId      String?
  agentId     String?
  executionId String?
  metadata    String?
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  agent       Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  execution   Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}
