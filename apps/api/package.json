{
  "name": "@raft-lite/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:prepare:e2e": "dotenv -e .env.e2e -- node scripts/reset-database.mjs && dotenv -e .env.e2e -- prisma db push --force-reset --skip-generate",
    "db:prepare:real-e2e": "dotenv -e .env.real-e2e -- node scripts/reset-database.mjs && dotenv -e .env.real-e2e -- prisma db push --force-reset --skip-generate",
    "start:e2e": "dotenv -e .env.e2e -- nest start",
    "start:real-e2e": "dotenv -e .env.real-e2e -- nest start",
    "test": "dotenv -e .env.test -- node scripts/reset-database.mjs && dotenv -e .env.test -- prisma db push --force-reset --skip-generate && dotenv -e .env.test -- vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "6.16.2",
    "@raft-lite/contracts": "workspace:*",
    "dotenv": "^17.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.16.21",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "socket.io-client": "^4.8.1",
    "prisma": "6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.4"
  }
}
