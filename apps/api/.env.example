DATABASE_URL="file:./dev.db"
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
E2E_TEST_MODE=false
MOCK_TICK_MS=650
WEB_ORIGIN=http://localhost:5173

# Optional: pair a Haft Agent Runner. The bootstrap token is a one-time pairing
# secret; the server stores only the hash of the issued runner token.
# HAFT_RUNNER_BOOTSTRAP_TOKEN="replace-with-a-long-random-value"
# HAFT_RUNNER_ADMIN_TOKEN=""
# HAFT_RUNNER_HEARTBEAT_TIMEOUT_MS=45000
# HAFT_RUNNER_RECONNECT_GRACE_MS=60000
# HAFT_RUNNER_CANCEL_TIMEOUT_MS=30000
